    {
      "id": "story-pip-hat",
      "type": "storybook",
      "title": "Story time: Pip Finds a Hat",
      "category": "stories",
      "minutes": 5,
      "level": 1,
      "skills": [
        "comprehension",
        "sight-words"
      ],
      "cover": "assets/images/cover-pip-finds-a-hat.jpg",
      "isNew": false,
      "summary": "A curious puppy finds a little red hat. Practice short a and i words together.",
      "payload": {
        "wordsToListenFor": [
          "hat",
          "big",
          "sit",
          "red"
        ],
        "beforeYouRead": "Ask Maya what she thinks Pip will find.",
        "pages": [
          {
            "image": "assets/images/cover-pip-finds-a-hat.jpg",
            "text": "Pip is a little pup.",
            "highlight": [
              "pup"
            ],
            "coachTip": "Point to the word pup. Ask Maya what sound it starts with.",
            "audio": "assets/audio/stories/story-pip-hat-1.m4a"
          },
          {
            "image": "assets/images/cover-pip-small.jpg",
            "text": "Pip can dig and dig.",
            "highlight": [
              "dig"
            ],
            "coachTip": "Dig is said twice. Let Maya read the second one.",
            "audio": "assets/audio/stories/story-pip-hat-2.m4a"
          },
          {
            "image": "assets/images/story-pip-page3.jpg",
            "text": "Pip sees a red hat. Is it a big hat? No, it is a little hat!",
            "highlight": [
              "red",
              "hat"
            ],
            "coachTip": "Point to the word hat. Ask Maya to find it again on this page.",
            "audio": "assets/audio/stories/story-pip-hat-3.m4a"
          },
          {
            "image": "assets/images/cover-pip-finds-a-hat.jpg",
            "text": "Pip sits in the sun with his hat.",
            "highlight": [
              "sits",
              "sun"
            ],
            "coachTip": "Sits and sun both start with s. Hiss it together: sss.",
            "audio": "assets/audio/stories/story-pip-hat-4.m4a"
          }
        ]
      }
    },
